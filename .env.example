# Copy to .env for local dev. These same two values also go in the Netlify
# dashboard (Site settings -> Environment variables) for Phase 5.
#
# This is the PUBLISHABLE key — safe to ship in browser code because anon only
# has column-level INSERT on the bookings table and no read grant at all.
# NEVER put the service_role key here, in Netlify, or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
